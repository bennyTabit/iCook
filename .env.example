EXPO_PUBLIC_GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_oauth_client_id_here

# Firebase — get from console.firebase.google.com → Project Settings → Your apps → Web
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Virtual Chef (Layer 3) ──────────────────────────────────────────────────
# Claude API — get from console.anthropic.com
# ⚠️  For production: proxy through a backend instead of exposing client-side
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# ElevenLabs — get from elevenlabs.io → Profile → API Keys
# ⚠️  For production: proxy through a backend instead of exposing client-side
EXPO_PUBLIC_ELEVENLABS_API_KEY=
# Voice ID — default is "Rachel" (warm multilingual female). Browse at elevenlabs.io/voice-library
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
